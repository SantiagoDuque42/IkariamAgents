{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategist.orders.v1.json",
  "title": "Strategist orders v1 — the click list the player executes by hand",
  "allOf": [{ "$ref": "envelope.v1.json" }],
  "properties": {
    "schema": { "const": "strategist.orders.v1" },
    "payload": {
      "type": "object",
      "required": ["basis", "goal", "horizonHours", "towns"],
      "properties": {
        "basis": {
          "type": "object",
          "required": ["snapshot"],
          "description": "The store files these orders were computed from",
          "properties": {
            "snapshot": { "type": "string", "description": "File name of the Mayor snapshot" },
            "maps": { "type": "array", "items": { "type": "string" } },
            "doctrineVersion": { "type": "string" }
          }
        },
        "goal": { "type": "string" },
        "horizonHours": { "type": "number", "exclusiveMinimum": 0 },
        "towns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["town", "steps"],
            "properties": {
              "town": { "type": "string" },
              "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } }
            }
          }
        },
        "empire": { "type": "array", "items": { "$ref": "#/$defs/step" }, "description": "Steps not tied to one town (research, government, trader)" },
        "expected": {
          "type": "array",
          "description": "Predicted state at checkpoints, compared later against the next snapshot",
          "items": {
            "type": "object",
            "required": ["atHours"],
            "properties": {
              "atHours": { "type": "number" },
              "population": { "type": "object", "additionalProperties": { "type": "number" } },
              "prodPerHour": { "type": "object", "additionalProperties": { "type": "number" } }
            }
          }
        },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": ["kind", "text"],
      "properties": {
        "kind": { "enum": ["build", "allocate", "wine", "transport", "trade", "research", "government", "military", "other"] },
        "text": { "type": "string", "description": "Exact instruction as the player would click it" },
        "params": { "type": "object" },
        "why": { "type": "string" },
        "due": { "type": "string", "description": "When to do it (ISO time or 'now')" },
        "status": { "enum": ["proposed", "accepted", "done", "skipped"], "default": "proposed" },
        "exec": { "$ref": "#/$defs/exec", "description": "Machine-checkable form of the step, for Basileus. Only steps with exec can be executed by it." }
      }
    },
    "res": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "wood": { "type": "integer", "minimum": 0 }, "wine": { "type": "integer", "minimum": 0 }, "marble": { "type": "integer", "minimum": 0 }, "glass": { "type": "integer", "minimum": 0 }, "sulfur": { "type": "integer", "minimum": 0 } }
    },
    "exec": {
      "oneOf": [
        {
          "type": "object", "title": "build",
          "required": ["action", "town", "building", "fromLevel", "toLevel"],
          "properties": {
            "action": { "const": "build" },
            "town": { "type": "string" }, "townId": { "type": "string" },
            "building": { "type": "string", "description": "Internal name, e.g. tavern, townHall, warehouse" },
            "position": { "type": "integer", "description": "Building ground index, needed for new buildings and multi-instance buildings" },
            "fromLevel": { "type": "integer", "minimum": 0, "description": "Precondition: current level (0 = new building)" },
            "toLevel": { "type": "integer", "minimum": 1 },
            "maxCost": { "$ref": "#/$defs/res", "description": "Abort if the game asks for more than this" }
          }
        },
        {
          "type": "object", "title": "transport",
          "required": ["action", "from", "to", "resources"],
          "properties": {
            "action": { "const": "transport" },
            "from": { "type": "string" }, "to": { "type": "string" },
            "fromId": { "type": "string" }, "toId": { "type": "string" },
            "resources": { "$ref": "#/$defs/res" },
            "keepAtLeast": { "$ref": "#/$defs/res", "description": "Precondition: the source keeps at least this much after sending" }
          }
        },
        {
          "type": "object", "title": "workers",
          "required": ["action", "town"],
          "properties": {
            "action": { "const": "workers" },
            "town": { "type": "string" }, "townId": { "type": "string" },
            "wood": { "type": "integer", "minimum": 0 }, "lux": { "type": "integer", "minimum": 0 }, "scientists": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object", "title": "wine",
          "required": ["action", "town", "level"],
          "properties": {
            "action": { "const": "wine" },
            "town": { "type": "string" }, "townId": { "type": "string" },
            "level": { "type": "integer", "minimum": 0, "description": "Tavern serving level; must not exceed the tavern level" }
          }
        }
      ]
    }
  }
}
